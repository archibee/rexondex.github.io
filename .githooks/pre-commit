#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$root/scripts/seo-pre-commit.ps1"
elif command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/seo-pre-commit.ps1"
else
  echo "SEO automation requires PowerShell (pwsh or powershell.exe)." >&2
  exit 1
fi
